# ---------------------------------------------------------------------------
# 无线配置 ---- 全部照抄设备当前值，SSID / 密码 / 加密方式 / 信道策略都不改
#
# 原厂实际的 SSID 与密钥：
#   2.4G  TENDAINF-D9DA        9876543210   psk-mixed (WPA/WPA2)
#   5G    TENDAINF-D9DA-5G     9876543210   psk-mixed (WPA/WPA2)
#
# 原厂还有两套没用的配置，这里不搬：
#   MAP-E4671ECCD9DA  厂商 mesh 回程用（hidden，密钥是随机串），普通路由器用不到
#   *-Guest           原厂是 disabled 状态，未启用
#
# 两个射频的 path 取自原配置，对应 SoC 集成的双频 FullMAC：
#   2.4G  platform/11000000.wifi-lb
#   5G    platform/17800000.wifi-hb
# ---------------------------------------------------------------------------

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/11000000.wifi-lb'
	option band '2g'
	option channel 'auto'
	option htmode 'HT20'
	option country 'CN'
	option noscan '1'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'TENDAINF-D9DA'
	option encryption 'psk-mixed'
	option key '9876543210'
	option hidden '0'
	option isolate '0'
	option wds '1'
	option ieee80211w '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/17800000.wifi-hb'
	option band '5g'
	option channel 'auto'
	option htmode 'VHT80'
	option country 'CN'
	option noscan '0'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'TENDAINF-D9DA-5G'
	option encryption 'psk-mixed'
	option key '9876543210'
	option hidden '0'
	option isolate '0'
	option wds '1'
	option ieee80211w '0'
